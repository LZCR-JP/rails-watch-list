<div class="hero">
  <h1>Save any kind of movies</h1>
</div>

<div class="lists-header">
  <h2>My Lists</h2>
  <%= link_to "Create a movie list", new_list_path, class: "btn-green" %>
</div>

<div class="cards">
  <% @lists.each do |list| %>
    <% if list.photo.present? %>
      <% bg = "background-image: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)), url('#{image_path(list.photo)}');" %>
    <% else %>
      <% bg = "background-color: #333;" %>
    <% end %>
    <%= link_to list_path(list), class: "list-tile", style: bg do %>
    <%= list.name %>
    <% end %>
  <% end %>
</div>