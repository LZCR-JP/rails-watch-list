<div class="container mt-3">
    <div class="dflex justify-content-between align-items-center">
        <h1>My lists</h1>
        <div class="cards">
          <% @lists.each do |list| %>
            <%= link_to list_path(list), class: "list-card" do %>
              <% if list.photo.present? %>
                <%= image_tag list.photo, alt: list.name %>
              <% end %>
             <h2><%= list.name %></h2>
            <% end %>
          <% end %>
        </div>
        <h2>Movies</h2>

        <% @movies.each do |movie| %>
        <div>
            <h3><%= movie.title %></h3>
            <p><%= movie.overview %></p>
        </div>
        <% end %>
    </div>
</div>